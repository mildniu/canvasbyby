# 网页登录密码（必填）
ACCESS_PASSWORD=change-me
# cookie签名+APIKey加密密钥，32位以上随机串（必填，固定后不要改）
SECRET_KEY=
# 监听端口
PORT=3300
# 数据目录（SQLite + 生成的图片）
DATA_DIR=./data

# ---- Android App / 跨源访问 ----
# 允许跨源携带 Cookie 访问的来源（逗号分隔；Capacitor 已默认放行）
CORS_ORIGINS=
# 纯 HTTP 本地开发时设为 lax（Cookie sameSite=lax）；HTTPS 生产保持默认 none
COOKIE_SAMESITE=
